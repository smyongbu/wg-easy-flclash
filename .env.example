WG_EASY_VERSION=15.3.0
# 使用 GitHub Actions 构建的镜像时，取消下一行注释
# WG_EASY_IMAGE=ghcr.io/smyongbu/wg-easy-flclash:latest
WG_PORT=51820
WG_UI_PORT=51821
WG_UI_BIND=0.0.0.0

# 这些远端局域网网段通过 WireGuard；隧道网段会由服务端自动加入。
# 多个网段用英文逗号分隔。
FLCLASH_REMOTE_CIDRS=192.168.1.0/24

# WireGuard 公网端点只有 AAAA 记录时使用 ipv6；普通双栈域名使用 dual。
# 可选：dual、ipv4、ipv6、ipv4-prefer、ipv6-prefer。
FLCLASH_ENDPOINT_IP_VERSION=ipv6
